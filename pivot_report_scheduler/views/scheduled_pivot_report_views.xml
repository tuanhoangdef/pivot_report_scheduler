<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="scheduled_pivot_report_view_list" model="ir.ui.view">
        <field name="name">scheduled.pivot.report.list</field>
        <field name="model">scheduled.pivot.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="schedule"/>
                <field name="favorite_filter_id"/>
                <field name="model_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="scheduled_pivot_report_view_form" model="ir.ui.view">
        <field name="name">scheduled.pivot.report.form</field>
        <field name="model">scheduled.pivot.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_report" type="object" string="Send Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="schedule"/>
                            <field name="weekly_send_day" invisible="schedule != 'weekly'"/>
                            <field name="favorite_filter_id"/>
                            <field name="model_id"/>
                            <field name="title"/>
                            <field name="email_template_id"/>
                        </group>
                        <group>
                            <field name="recipient_partner_ids" widget="many2many_tags"/>
                            <field name="recipient_emails"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scheduled_pivot_report_action" model="ir.actions.act_window">
        <field name="name">Scheduled Pivot Reports</field>
        <field name="res_model">scheduled.pivot.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_reporting_pivot_sales"
              name="Scheduled Pivot Reports"
              parent="sale.menu_sale_report"
              action="scheduled_pivot_report_action"
              groups="sales_team.group_sale_manager"
              sequence="90"/>

    <menuitem id="menu_action_account_invoice_report_scheduled_pivot"
              name="Scheduled Pivot Reports"
              parent="account.account_reports_management_menu"
              action="scheduled_pivot_report_action"
              groups="account.group_account_manager"
              sequence="90"/>

</odoo>
